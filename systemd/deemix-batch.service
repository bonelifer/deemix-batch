[Unit]
Description=Move finished deemix downloads to their destination

[Service]
Type=oneshot
WorkingDirectory=%h/Desktop/repos/misc/deemix-batch
# install.sh renders the actual project/staging paths with systemd quoting.
# If copying manually, edit both paths and --source yourself.
ExecStart=%h/Desktop/repos/misc/deemix-batch/sync_to_dest.py --source %h/deemix-downloads
