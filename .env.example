# Copy this file to ".env" and fill in your values. .env is gitignored.

# --- staging directory ---
# Where downloaded music lands before it's synced elsewhere. Used as the
# default for download_artists.py's -o and sync_to_dest.py's --source, so
# you don't have to pass the same path to both every time. Either script's
# own flag still overrides this if you pass it explicitly.
STAGING_DIR=/home/you/deemix-downloads

# --- download quality ---
# Default passed to the downloader as --bitrate. One of: 128, 320, flac.
# Optional -- an explicit --bitrate on the command line still overrides it.
BITRATE=128

# For users who always want the featured-releases tab included, not just
# the main discography. true/false. Optional -- pass --no-discography on
# download_artists.py's command line to turn this back off for one run.
DISCOGRAPHY=false

# --- sync destination ---
# Any local directory: a NAS mount, a MusicBrainz Picard inbox for fixing
# and organizing tags, or just a plain folder. Must already exist -- this
# script does not mount or create it. Finished artist folders are moved to:
#   <DEST_PATH>/<DEST_SUBPATH>/<Artist>/
DEST_PATH=/mnt/nas-music
DEST_SUBPATH=/media/music

# Copy instead of move, keeping local copies too. true/false. Optional --
# pass --copy or --no-copy on sync_to_dest.py's command line to override
# this for one run.
COPY=false

# Only move a folder once nothing inside it has changed for this many
# seconds (safety fallback for folders download_artists.py didn't download,
# so there's no completion record for them). Optional, default 300.
STABLE_FOR=300
